    "    \"    \\\"        if newNumber == 0:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            supernacciNumbers.append(supernacciNumbers[-1])\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(supernacciNumbers)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        elif newNumber == 1:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            supernacciNumbers.append(supernacciNumbers[-1])\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(supernacciNumbers)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        elif newNumber == 2:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            sumNumber = sum(supernacciNumbers[-2:])\\\\n\\\",\\n\",\n",
    "    \"    \\\"            supernacciNumbers.append(sumNumber)\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(supernacciNumbers)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        else:\\\\n\\\",\\n\",\n",
    "    \"    \\\"            print(\\\\\\\"Something went terribly wrong xd\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"    return\\\"\\n\",\n",
