    "    \"    \\\"def supernacci(n):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    supernacciNumbers = [1]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for i in range(2, n+1):\\\\n\\\",\\n\",\n",
